+package config
+
+import "testing"
+
+func strptr(s string) *string { return &s }
+
+// TestEffectiveAgentLabel_DisabledByDefault pins the zero-regression property.
+func TestEffectiveAgentLabel_DisabledByDefault(t *testing.T) {
+	cfg := &Config{}
+	proj := &ProjectConfig{Name: "my-workbuddy"}
+	if got := EffectiveAgentLabel(cfg, proj); got != "" {
+		t.Errorf("EffectiveAgentLabel() = %q, want empty", got)
+	}
+}
+
+// TestEffectiveAgentLabel_RendersLabel checks the happy path: a {label}
+// template is replaced by the project's label field.
+func TestEffectiveAgentLabel_RendersLabel(t *testing.T) {
+	cfg := &Config{}
+	cfg.Display.AgentLabel = strptr("【{label}】")
+	proj := &ProjectConfig{Name: "my-workbuddy", Label: "WorkBuddy"}
+	if got, want := EffectiveAgentLabel(cfg, proj), "【WorkBuddy】"; got != want {
+		t.Errorf("EffectiveAgentLabel() = %q, want %q", got, want)
+	}
+}
+
+// TestEffectiveAgentLabel_FallsBackToProjectName covers projects that never set
+// label — the project name keeps the output identifiable.
+func TestEffectiveAgentLabel_FallsBackToProjectName(t *testing.T) {
+	cfg := &Config{}
+	cfg.Display.AgentLabel = strptr("[{label}] ")
+	proj := &ProjectConfig{Name: "my-dsh"}
+	if got, want := EffectiveAgentLabel(cfg, proj), "[my-dsh] "; got != want {
+		t.Errorf("EffectiveAgentLabel() = %q, want %q", got, want)
+	}
+}
+
+// TestEffectiveAgentLabel_ProjectOverridesGlobal mirrors EffectiveCardMode:
+// a project-level value wins over the global one.
+func TestEffectiveAgentLabel_ProjectOverridesGlobal(t *testing.T) {
+	cfg := &Config{}
+	cfg.Display.AgentLabel = strptr("【{label}】")
+	proj := &ProjectConfig{Name: "my-workbuddy", Label: "WorkBuddy"}
+	proj.Display = &DisplayConfig{AgentLabel: strptr("<{label}> ")}
+	if got, want := EffectiveAgentLabel(cfg, proj), "<WorkBuddy> "; got != want {
+		t.Errorf("EffectiveAgentLabel() = %q, want %q", got, want)
+	}
+}
+
+// TestEffectiveAgentLabel_BlankIsOff treats whitespace-only configuration as
+// "disabled" rather than emitting a whitespace prefix.
+func TestEffectiveAgentLabel_BlankIsOff(t *testing.T) {
+	cfg := &Config{}
+	cfg.Display.AgentLabel = strptr("   ")
+	proj := &ProjectConfig{Name: "my-workbuddy"}
+	if got := EffectiveAgentLabel(cfg, proj); got != "" {
+		t.Errorf("EffectiveAgentLabel() = %q, want empty", got)
+	}
+}
+
+// TestEffectiveAgentLabel_LiteralWithoutPlaceholder lets operators hard-code a
+// fixed prefix when they do not want the project name in it.
+func TestEffectiveAgentLabel_LiteralWithoutPlaceholder(t *testing.T) {
+	cfg := &Config{}
+	cfg.Display.AgentLabel = strptr("[BOT] ")
+	proj := &ProjectConfig{Name: "my-workbuddy"}
+	if got, want := EffectiveAgentLabel(cfg, proj), "[BOT] "; got != want {
+		t.Errorf("EffectiveAgentLabel() = %q, want %q", got, want)
+	}
+}
+
+// TestEffectiveAgentLabel_NilProject must not panic — reload paths can call it
+// with a missing project.
+func TestEffectiveAgentLabel_NilProject(t *testing.T) {
+	cfg := &Config{}
+	cfg.Display.AgentLabel = strptr("【{label}】")
+	if got := EffectiveAgentLabel(cfg, nil); got != "" {
+		t.Errorf("EffectiveAgentLabel(nil) = %q, want empty", got)
+	}
+}
diff --git a/core/agent_label_test.go b/core/agent_label_test.go
new file mode 100644
