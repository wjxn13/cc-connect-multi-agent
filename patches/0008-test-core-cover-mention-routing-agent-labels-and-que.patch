+package core
+
+import (
+	"strings"
+	"testing"
+)
+
+// makeQueueNoticeEngine builds an engine configured the way main.go wires it:
+// a bare project label for message bodies, a queue capacity, and optional peers
+// for the mention gate.
+func makeQueueNoticeEngine(projectLabel string, maxQueued int, peers map[string][]string) (*Engine, *stubPlatformEngine) {
+	p := &stubPlatformEngine{n: "test"}
+	e := NewEngine("my-workbuddy", &stubAgent{}, []Platform{p}, "", LangChinese)
+	e.SetDisplayConfig(DisplayCfg{ProjectLabel: projectLabel})
+	e.maxQueuedMessages = maxQueued
+	e.SetMentionRouting([]string{"@wb"}, peers, "silent")
+	return e, p
+}
+
+// TestQueuedMessage_FullDetail is the contract the user asked for: the queue
+// notice must say WHERE the message landed, WHO is holding the session, and WHO
+// will eventually run it — not just "received".
+func TestQueuedMessage_FullDetail(t *testing.T) {
+	e, _ := makeQueueNoticeEngine("WorkBuddy", 5, map[string][]string{
+		"my-project": {"@claude"},
+		"my-dsh":     {"@dsh"},
+	})
+	got := e.queuedMessageConfirmation(1)
+
+	for _, want := range []string{"📬", "第 1/5 位", "WorkBuddy", "@claude", "@dsh"} {
+		if !strings.Contains(got, want) {
+			t.Errorf("queue notice missing %q\n--- got ---\n%s", want, got)
+		}
+	}
+}
+
+// TestQueuedMessage_KeepsBaseSentence protects the existing contract asserted by
+// engine_test.go: the original sentence must still be present verbatim, because
+// other tests (and users' muscle memory) match on it.
+func TestQueuedMessage_KeepsBaseSentence(t *testing.T) {
+	e, _ := makeQueueNoticeEngine("WorkBuddy", 5, nil)
+	got := e.queuedMessageConfirmation(1)
+	if !strings.HasPrefix(got, e.i18n.T(MsgMessageQueued)) {
+		t.Errorf("queue notice must start with the base sentence\n--- got ---\n%s", got)
+	}
+}
+
+// TestQueuedMessage_NoPeersOmitsReroute pins that the redirect hint is dropped
+// rather than rendered empty when there is nobody to redirect to.
+func TestQueuedMessage_NoPeersOmitsReroute(t *testing.T) {
+	e, _ := makeQueueNoticeEngine("WorkBuddy", 5, nil)
+	got := e.queuedMessageConfirmation(1)
+	if strings.Contains(got, "改派") {
+		t.Errorf("expected no reroute hint without peers\n--- got ---\n%s", got)
+	}
+	if strings.Contains(got, "%!") {
+		t.Errorf("format verb left unrendered\n--- got ---\n%s", got)
+	}
+}
+
+// TestQueuedMessage_FallsBackToProjectName covers the unlabelled deployment: an
+// operator who never sets `label` must still see a readable agent name.
+func TestQueuedMessage_FallsBackToProjectName(t *testing.T) {
+	e, _ := makeQueueNoticeEngine("", 5, nil)
+	got := e.queuedMessageConfirmation(2)
+	if !strings.Contains(got, "my-workbuddy") {
+		t.Errorf("expected fallback to project name\n--- got ---\n%s", got)
+	}
+}
+
+// TestQueuedMessage_ExposesDepth guards the numbers themselves: position and
+// capacity must track the real values, not a hard-coded pair.
+func TestQueuedMessage_ExposesDepth(t *testing.T) {
+	e, _ := makeQueueNoticeEngine("WorkBuddy", 8, nil)
+	if got := e.queuedMessageConfirmation(3); !strings.Contains(got, "第 3/8 位") {
+		t.Errorf("expected position 3/8\n--- got ---\n%s", got)
+	}
+}
+
+// TestFailedToStartSession_NamesAgent is the second half of the request: when
+// session startup fails the user must be told WHICH agent broke.
+func TestFailedToStartSession_NamesAgent(t *testing.T) {
+	e, _ := makeQueueNoticeEngine("DSH", 5, nil)
+	got := e.failedToStartSessionNotice()
+
+	if !strings.HasPrefix(got, e.i18n.T(MsgFailedToStartAgentSession)) {
+		t.Errorf("must start with the base error sentence\n--- got ---\n%s", got)
+	}
+	if !strings.Contains(got, "DSH") {
+		t.Errorf("error notice must name the failing agent\n--- got ---\n%s", got)
+	}
+	if !strings.Contains(got, "/stop") {
+		t.Errorf("error notice should carry the recovery hint\n--- got ---\n%s", got)
+	}
+}
+
+// TestFailedToStartSession_FallsBackToProjectName mirrors the queue-notice
+// fallback so an unlabelled project is never left with a blank agent name.
+func TestFailedToStartSession_FallsBackToProjectName(t *testing.T) {
+	e, _ := makeQueueNoticeEngine("", 5, nil)
+	if got := e.failedToStartSessionNotice(); !strings.Contains(got, "my-workbuddy") {
+		t.Errorf("expected fallback to project name\n--- got ---\n%s", got)
+	}
+}
+
+// TestQueueDetailMessages_AllLanguagesComplete is a translation-completeness
+// guard: every language must define the new strings AND carry the same number of
+// format verbs. A missing Spanish row or a mistyped %d would otherwise surface
+// only as "%!d(MISSING)" in a user's chat window.
+func TestQueueDetailMessages_AllLanguagesComplete(t *testing.T) {
+	langs := []Language{LangEnglish, LangChinese, LangTraditionalChinese, LangJapanese, LangSpanish}
+	cases := map[MsgKey]int{
+		MsgMessageQueuedDetail:      4,
+		MsgMessageQueuedReroute:     1,
+		MsgFailedToStartSessionWhom: 1,
+	}
+
+	for key, wantVerbs := range cases {
+		entry, ok := messages[key]
+		if !ok {
+			t.Errorf("missing message key %q", key)
+			continue
+		}
+		for _, lang := range langs {
+			text, ok := entry[lang]
+			if !ok || strings.TrimSpace(text) == "" {
+				t.Errorf("%s: language %q missing", key, lang)
+				continue
+			}
+			if got := strings.Count(text, "%"); got != wantVerbs {
+				t.Errorf("%s[%s]: has %d format verbs, want %d (%q)", key, lang, got, wantVerbs, text)
+			}
+		}
+	}
+}
