+// TestMentionSticky_MarkHoldsASet pins the multi-@ half of the registry: one
+// leading run may brief several projects, and every one of them owns the media
+// that follows.
+func TestMentionSticky_MarkHoldsASet(t *testing.T) {
+	s := NewMentionSticky(time.Minute)
+
+	s.Mark("sess", "my-workbuddy", "my-dsh")
+	if got := s.Lookup("sess"); !reflect.DeepEqual(got, []string{"my-workbuddy", "my-dsh"}) {
+		t.Errorf("Lookup = %v, want both projects in the order marked", got)
+	}
+
+	// A repeated name is kept once: the set is what is being routed to, and a
+	// duplicate would only make the drop log harder to read.
+	s.Mark("sess", "my-dsh", "my-dsh", "my-workbuddy")
+	if got := s.Lookup("sess"); !reflect.DeepEqual(got, []string{"my-dsh", "my-workbuddy"}) {
+		t.Errorf("Lookup after dedup = %v, want two distinct projects", got)
+	}
+
+	// Marking must REPLACE, not merge: a later single-@ message narrows the set.
+	// Merging would keep a photo fanning out to a project the user had already
+	// moved on from.
+	s.Mark("sess", "my-dsh")
+	if got := s.Lookup("sess"); !reflect.DeepEqual(got, []string{"my-dsh"}) {
+		t.Errorf("Lookup after narrowing = %v, want [my-dsh] only", got)
+	}
+
+	// A Mark with nothing usable in it must not erase what is already there.
+	s.Mark("sess", "my-dsh", "my-workbuddy")
+	s.Mark("sess", "", "")
+	if got := s.Lookup("sess"); !reflect.DeepEqual(got, []string{"my-dsh", "my-workbuddy"}) {
+		t.Errorf("Lookup after an all-blank Mark = %v, want the previous set intact", got)
+	}
+
+	// What Lookup hands out must be a copy: a caller editing the slice must not
+	// be able to corrupt the registry.
+	got := s.Lookup("sess")
+	got[0] = "mutated"
+	if again := s.Lookup("sess"); again[0] != "my-dsh" {
+		t.Errorf("Lookup returned a shared backing array: %v", again)
 	}
 }
 
