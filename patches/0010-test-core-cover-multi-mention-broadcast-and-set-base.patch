 // gatedEngine builds an engine with the mention gate installed the same way
 // main.go does it for one project.
+//
+// The engine carries a name because a leading run that names us puts this name
+// into the addressed set (the set feeds the photo-stickiness registry, and we
+// are as much an owner of the following photo as any peer). An unnamed engine
+// would silently take a different path, and a test that never exercises the real
+// one is not worth much.
 func gatedEngine(self []string, peers map[string][]string, fallback string) *Engine {
-	e := &Engine{}
+	e := &Engine{name: "my-self"}
 	e.SetMentionRouting(self, peers, fallback)
 	return e
 }
