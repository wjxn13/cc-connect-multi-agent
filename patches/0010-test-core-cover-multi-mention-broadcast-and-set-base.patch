-// TestMentionGate_FirstMentionWins pins the positional rule. A set-based rule
-// ("drop whenever any peer alias appears") would silence both agents on a
-// message that names two of them, leaving the user with no reply at all.
-func TestMentionGate_FirstMentionWins(t *testing.T) {
+// TestMentionGate_LeadingRunWins pins the first of the two rules: a contiguous
+// run of aliases at the very start of the message addresses ALL of them, and the
+// message is then read no further.
+//
+// The run must not be confused with a set-based rule ("answer whenever our alias
+// appears anywhere"). That rule would make "@claude ask @dsh to run it" address
+// both agents, and the user asking Claude to brief DSH would get two replies
+// (or, worse, two agents racing on the same task). A name outside the leading run
+// is far more often mentioned ABOUT someone than addressed TO them, so it does
+// not route anything.
+func TestMentionGate_LeadingRunWins(t *testing.T) {
 	e := standardClaudeEngine()
 
+	// Self opens the run: we answer, and the peer named after it is not an owner
+	// of this message as far as we are concerned.
 	if got, tok := e.mentionGateDrop("@claude 帮我叫 @dsh 干活"); got != "" {
 		t.Errorf("self first must answer, got dropped by %q (token %q)", got, tok)
 	}
+
+	// A single leading name followed by a mention in the body: only the leading
+	// run counts, so the body mention routes nowhere.
 	if got, _ := e.mentionGateDrop("@dsh 先看，@claude 再说"); got != "my-dsh" {
-		t.Errorf("peer first must drop, got %q", got)
+		t.Errorf("leading run must decide, got %q", got)
 	}
 	if got, _ := e.mentionGateDrop("@workbuddy 别插话，然后 @dsh 上"); got != "my-workbuddy" {
-		t.Errorf("first of two peers must win, got %q", got)
+		t.Errorf("leading run of one must decide, got %q", got)
+	}
+
+	// A peer opening the run while we are named later inside the same run: the
+	// run is read to its end, so we are addressed too and must answer.
+	if got, _ := e.mentionGateDrop("@dsh @claude 是谁"); got != "" {
+		t.Errorf("self inside the leading run must answer, got dropped by %q", got)
+	}
+
+	// Same shape, but we are not in the run at all: we stay out of it.
+	if got, _ := e.mentionGateDrop("@dsh @workbuddy 开会"); got != "my-dsh,my-workbuddy" {
+		t.Errorf("both peers in the leading run must be reported, got %q", got)
+	}
+}
+
+// TestMentionGate_LeadingRunSeparators pins which characters may sit between two
+// names inside the run. Chinese input arrives with fullwidth punctuation, and
+// "@wb，@dsh" typed on a real IME is the shape this feature was asked for — a rule
+// that only accepted a bare space would broadcast on the test rig and on nothing
+// else.
+func TestMentionGate_LeadingRunSeparators(t *testing.T) {
+	e := standardClaudeEngine()
+
+	// Same decision as seen BY the peer: both peers own the message.
+	peerView := gatedEngine(
+		[]string{"@claude"},
+		map[string][]string{
+			"my-dsh":       {"@dsh"},
+			"my-workbuddy": {"@workbuddy"},
+		},
+		"answer",
+	)
+
+	for _, content := range []string{
+		"@dsh @workbuddy 开会",
+		"@dsh, @workbuddy 开会",
+		"@dsh，@workbuddy 开会",    // fullwidth comma
+		"@dsh、@workbuddy 开会",    // ideographic comma
+		"@dsh + @workbuddy 开会",  // the way a slash-command habit types it
+		"@dsh　@workbuddy 开会",    // ideographic space
+		"   @dsh @workbuddy 开会", // leading indent, e.g. a TOML multi-line prompt
+	} {
+		if got, _ := peerView.mentionGateDrop(content); got != "my-dsh,my-workbuddy" {
+			t.Errorf("mentionGateDrop(%q) = %q, want both peers", content, got)
+		}
+	}
+
+	// The run stops at the first thing that is neither separator nor alias, so a
+	// word between two names splits it.
+	if got, _ := e.mentionGateDrop("@dsh 先看 @workbuddy 再说"); got != "my-dsh" {
+		t.Errorf("a word must terminate the run, got %q", got)
+	}
+
+	// A bare "@" is not an alias; it ends the run rather than being skipped over,
+	// otherwise "@ @dsh" would quietly address dsh.
+	if got, _ := e.mentionGateDrop("@ @dsh 看下"); got != "my-dsh" {
+		t.Errorf("bare @ must not join the run, got %q", got)
 	}
 }
 
+// TestMentionGate_LeadingRunBroadcasts checks the feature at cluster level, which
+// is the only level where "everybody answered" is observable: each engine reads
+// the message with its own alias table, so a per-engine assertion can only say
+// what ONE of them decided.
+func TestMentionGate_LeadingRunBroadcasts(t *testing.T) {
+	c := newMentionCluster(time.Minute, "")
+
+	// Two names, one space apart: both answer.
+	assertDelivered(t, c.deliver("@wb @dsh 看下这个", 0), "my-dsh", "my-workbuddy")
+
+	// The fullwidth comma is how this actually gets typed on a Chinese IME.
+	assertDelivered(t, c.deliver("@wb，@dsh 看下这个", 0), "my-dsh", "my-workbuddy")
+
+	// Three names: all three answer.
+	assertDelivered(t, c.deliver("@claude @dsh @wb 开个会", 0),
+		"my-project", "my-dsh", "my-workbuddy")
+
+	// The leading run is read to its end even when the words after it read like a
+	// question about the agents rather than a task for them. This is the accepted
+	// cost of the rule the user chose (only a LEADING run broadcasts); the next
+	// case is the guard that keeps the cost from spreading to body mentions.
+	assertDelivered(t, c.deliver("@dsh @claude 是谁", 0), "my-project", "my-dsh")
+
+	// A name in the BODY is not a broadcast. Only the first name decides, exactly
+	// as before this feature.
+	assertDelivered(t, c.deliver("@dsh 先看，@claude 再说", 0), "my-dsh")
+
+	// A word between two names splits the run, leaving only the first addressed.
+	assertDelivered(t, c.deliver("@wb 先写，@dsh 再看", 0), "my-workbuddy")
+
+	// Peers only: the project left out of the run stays out.
+	assertDelivered(t, c.deliver("@dsh @wb 一起看", 0), "my-dsh", "my-workbuddy")
+}
