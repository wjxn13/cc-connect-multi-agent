+// TestBarePhoto_MultipleAddresseesAllReceiveIt is the second half of the
+// multi-@ contract, and the reason MentionSticky had to grow from a single name
+// into a set.
+//
+// "@wb @dsh 看这张图" is two messages as far as Weixin is concerned: the text, and
+// then the photo on its own. If the registry kept only the first name, the photo
+// would reach WB and silently vanish for DSH — the user would see exactly the bug
+// this registry was built to fix, just with two names instead of one.
+func TestBarePhoto_MultipleAddresseesAllReceiveIt(t *testing.T) {
+	c := newMentionCluster(time.Minute, "")
+
+	assertDelivered(t, c.deliver("@wb @dsh 看这张图", 0), "my-dsh", "my-workbuddy")
+
+	// Nobody is named, so both owners are resolved from the session's mark.
+	assertDelivered(t, c.deliver("", 1), "my-dsh", "my-workbuddy")
+
+	// The third project was never addressed; a permissive default must not make it
+	// grab the photo (my-workbuddy is the one with default="answer" here).
+	assertDelivered(t, c.deliver("", 1), "my-dsh", "my-workbuddy")
+
+	// Naming a single project afterwards narrows the set again rather than
+	// merging with it.
+	assertDelivered(t, c.deliver("@wb 只看我这张", 0), "my-workbuddy")
+	assertDelivered(t, c.deliver("", 1), "my-workbuddy")
+}
