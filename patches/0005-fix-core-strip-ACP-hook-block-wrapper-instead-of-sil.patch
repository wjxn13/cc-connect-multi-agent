+// TestProcessInteractiveEvents_StaleWrapperDoesNotEatReply 是本次修复的核心断言（真实引擎通路）：
+// "上一轮阻断包装 + 本轮真回复"的粘连体必须把真回复投递出去，而不是整条静默。
+//
+// 反证：修复前（先跑 isHookBlockedResponse）该用例会失败 —— 整条因前缀命中被静默，一条都发不出。
+func TestProcessInteractiveEvents_StaleWrapperDoesNotEatReply(t *testing.T) {
+	const real = "实验E 收到，状态干净：本条正常作答。"
+	sent := runHookBlockedDelivery(t, "stale-wrapper", "Operation stopped by hook: NO_REPLY"+real)
+	if len(sent) != 1 || sent[0] != real {
+		t.Fatalf("包装后粘连的真回复应被剥离并投递，实际发出 %#v", sent)
+	}
+}
