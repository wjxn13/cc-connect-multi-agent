+// TestStripHookBlockWrapper 钉死"剥离跨轮携带的阻断包装"的能力。
+//
+// 取证：2026-09-16 真机（cc-connect 的 my-workbuddy 项目 + CodeBuddy CLI 走 ACP）。
+// 连发两轮 —— 第一轮 @dsh 被钩子拦下；第二轮 @wb 本应正常回复，但会话历史里记的是：
+//
+//	[46] assistant | Operation stopped by hook: NO_REPLY实验E 收到，状态干净：…
+//
+// 即上一轮的包装文本与真实回复**直接粘连**（中间连空格都没有），整条因此命中前缀判定被静默。
+// 修复思路：把包装剥掉再看剩下什么，而不是一见前缀就整条静默。
+func TestStripHookBlockWrapper(t *testing.T) {
+	const claudeForm = "UserPromptSubmit operation blocked by hook:\nL2: …\n\nOriginal prompt: @dsh x"
+
+	cases := []struct {
+		name     string
+		text     string
+		wantRest string
+		wantHit  bool
+	}{
+		{
+			name:     "纯阻断包装 → 剥完为空（应静默）",
+			text:     "Operation stopped by hook: NO_REPLY",
+			wantRest: "",
+			wantHit:  true,
+		},
+		{
+			name:     "包装+真回复粘连 → 只剩真回复（应投递）",
+			text:     "Operation stopped by hook: NO_REPLY实验E 收到，状态干净：本条正常作答。",
+			wantRest: "实验E 收到，状态干净：本条正常作答。",
+			wantHit:  true,
+		},
+		{
+			name:     "带前导换行与空格",
+			text:     "\n\n  Operation stopped by hook: NO_REPLY真实回复",
+			wantRest: "真实回复",
+			wantHit:  true,
+		},
+		{
+			name:     "大小写不敏感",
+			text:     "OPERATION STOPPED BY HOOK: no_reply 真实回复",
+			wantRest: " 真实回复",
+			wantHit:  true,
+		},
+		{
+			// Claude Code 形态整段都是包装，边界不可知 → 不动它，交给 isHookBlockedResponse 静默
+			name:     "Claude Code 形态不剥离",
+			text:     claudeForm,
+			wantRest: claudeForm,
+			wantHit:  false,
+		},
+		{
+			// reason 换成别的文案就无法确定边界 → 退回"整条静默"。
+			// 这条用例的作用：一旦有人改了钩子的 reason 文案导致修复失效，测试会立刻报错。
+			name:     "reason 不是 NO_REPLY → 不剥离",
+			text:     "Operation stopped by hook: 换个文案真实回复",
+			wantRest: "Operation stopped by hook: 换个文案真实回复",
+			wantHit:  false,
+		},
+		{
+			name:     "普通回复不误伤",
+			text:     "已完成，三个 project 全部 platform ready。",
+			wantRest: "已完成，三个 project 全部 platform ready。",
+			wantHit:  false,
+		},
+	}
+
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			got, hit := stripHookBlockWrapper(tc.text)
+			if hit != tc.wantHit || got != tc.wantRest {
+				t.Fatalf("stripHookBlockWrapper(%q) = (%q, %v), want (%q, %v)",
+					tc.text, got, hit, tc.wantRest, tc.wantHit)
+			}
+		})
+	}
+}
