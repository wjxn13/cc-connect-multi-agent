+// hookBlockACPPrefixRe matches the ACP-platform hook-block wrapper prefix.
+//
+// 2026-09-16 真机实测（CodeBuddy CLI 走 ACP，cc-connect 的 my-workbuddy 项目）：
+// 阻断提示词时 CLI 产生的是 "Operation stopped by hook: <reason>"；并且这段文本会被
+// **带到下一轮的回复前面**，与真实回复直接粘连：
+//
+//	Operation stopped by hook: NO_REPLY实验E 收到，状态干净：…
+//
+// 若只用 isHookBlockedResponse 判静默，整条会因前缀命中而被丢弃 —— 本该投递的回复被吞。
+// 故必须有下面这个"剥离"能力。
+var hookBlockACPPrefixRe = regexp.MustCompile(`(?i)^\s*operation stopped by hook\s*:\s*`)
+
+// hookBlockReasonRe matches the reason marker our own hook writes.
+//
+// 注意：只吃标记本身，**不能**"切到行尾"。实测粘连形态是
+// "Operation stopped by hook: NO_REPLY实验E 收到，…" —— reason 与真回复之间连空格都没有，
+// 切到行尾会把真回复一起吃掉。
+var hookBlockReasonRe = regexp.MustCompile(`(?i)^NO_REPLY`)
+
+// stripHookBlockWrapper 剥离跨轮携带的钩子阻断包装，返回剥离后的文本与是否命中。
+//
+// 只处理 ACP 形态（"Operation stopped by hook: <reason>"），且要求 reason 确认为
+// 本仓钩子的 NO_REPLY 标记。这样既修掉"包装吞掉真回复"，又不会把 Claude Code 的
+// 整段包装文本误当回复投递（那种形态整段都是包装，交给 isHookBlockedResponse 静默）。
+//
+// 边界情况：包装后不是 NO_REPLY（例如换了 reason 文案）→ 无法确定边界，返回未命中，
+// 退回到原有的"整条静默"行为。所以**改钩子的 reason 文案会让本修复失效** ——
+// core/hook_block_silence_test.go 里有用例钉死这一点。
+func stripHookBlockWrapper(text string) (string, bool) {
+	loc := hookBlockACPPrefixRe.FindStringIndex(text)
+	if loc == nil {
+		return text, false
+	}
+	rest := text[loc[1]:]
+	rl := hookBlockReasonRe.FindStringIndex(rest)
+	if rl == nil || rl[0] != 0 {
+		return text, false
+	}
+	return rest[rl[1]:], true
+}
+
 // isSilentReply reports whether text is exactly a NO_REPLY marker.
 func isSilentReply(text string) bool {
 	return silentReplyRe.MatchString(text)
