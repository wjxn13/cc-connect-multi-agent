 // TestSilentReplySemanticsUnchanged 回归保护：新增钩子阻断判定不得改变原有
 // NO_REPLY 静默语义（bare marker 静默 / 尾随 marker 剥离 / 非末尾不匹配）。
 func TestSilentReplySemanticsUnchanged(t *testing.T) {
