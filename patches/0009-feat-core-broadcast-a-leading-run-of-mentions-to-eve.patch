+// mentionGateDrop reports which project(s) the message should be handed to
+// instead of this engine. An empty project name means "do not drop".
+//
+// Thin wrapper over mentionGateTargets, kept because the single-owner shape reads
+// better at the call sites and in the tests.
+func (e *Engine) mentionGateDrop(content string) (string, string) {
+	owners, tokens, mine := e.mentionGateTargets(content)
+	if mine || len(owners) == 0 {
+		return "", ""
+	}
+	return strings.Join(owners, ","), strings.Join(tokens, ",")
