+
+// scanLeadingMentionRun returns the aliases written in the contiguous run of
+// "@name" tokens at the very start of the message, or nil when the message does
+// not open with an alias.
+//
+// Leading whitespace and separators are skipped, so "  @wb，@dsh 你好" opens a run
+// of two. Anything that is neither a separator nor another alias terminates it.
+func scanLeadingMentionRun(content string) []string {
+	runes := []rune(content)
+	i := 0
+	for i < len(runes) && isMentionSeparator(runes[i]) {
+		i++
+	}
+	if i >= len(runes) || runes[i] != '@' {
+		return nil
+	}
+
+	var out []string
+	for i < len(runes) && runes[i] == '@' {
+		j := i + 1
+		for j < len(runes) && isMentionNameRune(runes[j]) {
+			j++
+		}
+		if j == i+1 {
+			break // a bare "@" is not an alias, and it ends the run
+		}
+		out = append(out, strings.ToLower(string(runes[i:j])))
+		i = j
+		for i < len(runes) && isMentionSeparator(runes[i]) {
+			i++
+		}
+	}
+	return out
+}
+
+// isMentionSeparator reports whether r may sit between two aliases inside the
+// leading run: whitespace (ASCII and ideographic) plus the punctuation people
+// type between names.
+func isMentionSeparator(r rune) bool {
+	switch r {
+	case ' ', '\t', '\n', '\r', '\v', '\f':
+		return true
+	case 0x00a0, 0x3000: // non-breaking space, ideographic space
+		return true
+	case ',', 0xff0c: // halfwidth, fullwidth comma
+		return true
+	case 0x3001: // ideographic comma
+		return true
+	case ';', 0xff1b: // halfwidth, fullwidth semicolon
+		return true
+	case '+', '&':
+		return true
 	}
-	return "", ""
+	return false
 }
 
