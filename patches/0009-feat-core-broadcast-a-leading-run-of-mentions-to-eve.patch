+// Mark records that the user just addressed `projects` on this session.
+//
+// It REPLACES any previous mark rather than merging: the question is "who did the
+// user address most recently", and a later "@dsh" must not keep an earlier
+// "@wb" alive, or a photo typed minutes afterwards would fan out to a project the
+// user had already moved on from.
+func (s *MentionSticky) Mark(sessionKey string, projects ...string) {
+	if s == nil || sessionKey == "" || len(projects) == 0 {
+		return
+	}
+	clean := make([]string, 0, len(projects))
+	seen := make(map[string]bool, len(projects))
+	for _, p := range projects {
+		if p == "" || seen[p] {
+			continue
+		}
+		seen[p] = true
+		clean = append(clean, p)
+	}
+	if len(clean) == 0 {
