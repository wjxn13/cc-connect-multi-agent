 }
 
+// EffectiveAgentLabel resolves the outgoing-message prefix for one project.
+//
+// The template comes from display.agent_label (project-level wins over global),
+// and its {label} placeholder is replaced by the project's `label` field —
+// falling back to the project name when that field is empty.
+//
+// Returns "" when labelling is disabled, which is the default: a project with
+// no agent_label configured behaves exactly as it did before this option
+// existed.
+func EffectiveAgentLabel(cfg *Config, proj *ProjectConfig) string {
+	format := ""
+	if proj != nil && proj.Display != nil && proj.Display.AgentLabel != nil {
+		format = *proj.Display.AgentLabel
+	} else if cfg != nil && cfg.Display.AgentLabel != nil {
+		format = *cfg.Display.AgentLabel
+	}
+	if strings.TrimSpace(format) == "" {
+		return ""
+	}
+
+	name := projectDisplayLabel(proj)
+	if name == "" {
+		return ""
+	}
+
+	// A template without {label} is used verbatim, so operators can hard-code a
+	// literal prefix such as "[BOT] " when they prefer that.
+	return strings.ReplaceAll(format, "{label}", name)
+}
+
+// projectDisplayLabel returns the bare human-facing name for a project: its
+// `label` field when non-empty, otherwise the project name. Returns "" only
+// when there is no project at all.
+func projectDisplayLabel(proj *ProjectConfig) string {
+	if proj == nil {
+		return ""
+	}
+	if s := strings.TrimSpace(proj.Label); s != "" {
+		return s
+	}
+	return strings.TrimSpace(proj.Name)
+}
+
+// EffectiveProjectLabel returns the BARE display name of a project, e.g.
+// "WorkBuddy" — what message bodies use when they must name the agent that is
+// busy or that failed ("当前占用：WorkBuddy").
+//
+// It is the same string EffectiveAgentLabel wraps in brackets, exposed
+// separately so a message body never has to strip punctuation back out of a
+// rendered prefix. Callers fall back to their own project name when this
+// returns "".
+func EffectiveProjectLabel(proj *ProjectConfig) string {
+	return projectDisplayLabel(proj)
+}
+
 // validatePermissive is like validate but skips the "at least one platform"
 // requirement so that commands like `cc-connect web` can operate on agent-only
 // configs before platforms have been set up.
@@ -1036,6 +1175,59 @@ func (c *Config) validateInternal(permissive bool) error {
 			return err
 		}
 	}
+	if err := validateMentionAgents(c); err != nil {
+		return err
+	}
+	return nil
+}
+
+// validateMentionAgents checks the global [[mention_agents]] table. The gate
+// is opt-in per project, so an empty table is always valid.
+func validateMentionAgents(c *Config) error {
+	if len(c.MentionAgents) == 0 {
+		return nil
+	}
+
+	known := make(map[string]bool, len(c.Projects))
+	for _, p := range c.Projects {
+		known[p.Name] = true
+	}
+
+	// alias → project that claimed it, to catch ambiguous configuration.
+	owner := make(map[string]string)
+	seenProject := make(map[string]bool)
+
+	for i, m := range c.MentionAgents {
+		prefix := fmt.Sprintf("mention_agents[%d]", i)
+
+		if m.Project == "" {
+			return fmt.Errorf("config: %s.project is required", prefix)
+		}
+		if !known[m.Project] {
+			return fmt.Errorf("config: %s.project %q does not match any [[projects]] name", prefix, m.Project)
+		}
+		if seenProject[m.Project] {
+			return fmt.Errorf("config: %s.project %q is declared more than once", prefix, m.Project)
+		}
+		seenProject[m.Project] = true
+
+		aliases := normalizeMentionAliasList(m.Aliases)
+		if len(aliases) == 0 {
+			return fmt.Errorf("config: %s (%s) needs at least one non-empty alias", prefix, m.Project)
+		}
+		for _, a := range aliases {
+			if prev, ok := owner[a]; ok {
+				return fmt.Errorf("config: alias %q is claimed by both %q and %q", a, prev, m.Project)
+			}
+			owner[a] = m.Project
+		}
+
+		switch strings.ToLower(strings.TrimSpace(m.Default)) {
+		case "", "answer", "silent":
+		default:
+			return fmt.Errorf("config: %s.default must be \"answer\" or \"silent\", got %q", prefix, m.Default)
+		}
+	}
 	return nil
 }
 
