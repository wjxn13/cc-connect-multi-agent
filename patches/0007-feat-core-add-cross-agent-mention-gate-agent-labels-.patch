diff --git a/core/mention_sticky.go b/core/mention_sticky.go
new file mode 100644
index 0000000..0f8df15
--- /dev/null
+++ b/core/mention_sticky.go
@@ -0,0 +1,107 @@
+package core
+
+import (
+	"sync"
+	"time"
+)
+
+// DefaultMentionStickyTTL is how long a project stays "the one being talked to"
+// after a user addresses it by alias.
+//
+// Why this exists: a Weixin photo arrives as a message with NO text at all
+// (content is the empty string), and the Weixin client offers no way to attach a
+// caption. Measured on this machine (2026-09-19):
+//
+//   - the image preview screen has no text box, so text and photo cannot be one
+//     message;
+//   - quoting a photo and typing text delivers the text but DROPS the photo
+//     (has_images=false);
+//   - quoting text and sending a photo delivers the photo but DROPS the quote
+//     (content_len=0).
+//
+// So "@dsh look at this" plus a photo always arrives as two messages, and the
+// second one names nobody. Without stickiness the gate reads that photo as
+// unaddressed and a project with default="silent" throws it away — which is
+// exactly what the user experiences as "the picture never reached the agent".
+//
+// Three minutes is deliberately short: long enough to cover "type the alias,
+// then pick a photo", short enough that someone who walked away does not
+// silently route a much later photo to a project they forgot they addressed.
+const DefaultMentionStickyTTL = 3 * time.Minute
+
+// MentionSticky remembers, per chat session, the project most recently addressed
+// by alias.
+//
+// ONE instance is shared by every engine in the process. The routing question
+// ("is this bare photo mine?") can only be answered by comparing what this engine
+// is called against what the session last addressed — knowledge no single engine
+// holds on its own, since each engine only ever sees its own aliases.
+type MentionSticky struct {
+	ttl time.Duration
+
+	mu    sync.Mutex
+	marks map[string]mentionStickyMark
+}
+
+type mentionStickyMark struct {
+	project string
+	at      time.Time
+}
+
+// NewMentionSticky builds a registry. A ttl <= 0 falls back to
+// DefaultMentionStickyTTL, so a zero value can never silently mean "expires
+// instantly" or "never expires".
+func NewMentionSticky(ttl time.Duration) *MentionSticky {
+	if ttl <= 0 {
+		ttl = DefaultMentionStickyTTL
+	}
+	return &MentionSticky{ttl: ttl, marks: make(map[string]mentionStickyMark)}
+}
+
+// Mark records that the user just addressed `project` on this session.
+func (s *MentionSticky) Mark(sessionKey, project string) {
+	if s == nil || sessionKey == "" || project == "" {
+		return
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.marks[sessionKey] = mentionStickyMark{project: project, at: time.Now()}
+}
+
+// Lookup returns the project most recently addressed on this session, or "" when
+// there is none or the mark has expired.
+func (s *MentionSticky) Lookup(sessionKey string) string {
+	if s == nil || sessionKey == "" {
+		return ""
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	mark, ok := s.marks[sessionKey]
+	if !ok {
+		return ""
+	}
+	if time.Since(mark.at) > s.ttl {
+		delete(s.marks, sessionKey)
+		return ""
+	}
+	return mark.project
+}
+
+// Forget drops the mark for one session. Used when a session is reset so a
+// /cancel or /new does not leave a stale owner behind.
+func (s *MentionSticky) Forget(sessionKey string) {
+	if s == nil || sessionKey == "" {
+		return
+	}
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	delete(s.marks, sessionKey)
+}
+
+// TTL reports the configured lifetime (for logging).
+func (s *MentionSticky) TTL() time.Duration {
+	if s == nil {
+		return 0
+	}
+	return s.ttl
+}
