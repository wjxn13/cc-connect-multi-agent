 // reloadConfig re-reads config.toml and applies hot-reloadable settings
 // (display, providers, commands) to the given engine.
+// mentionStickyForProcess is the single stickiness registry shared by every
+// engine in this process.
+//
+// Package scope is deliberate: reloadConfig() runs once per project and has no
+// other way to reach an instance created inside main's project loop. It also has
+// to survive /config reload — the user's "I was just talking to DSH" context does
+// not become invalid because the config file was re-read.
+var mentionStickyForProcess = core.NewMentionSticky(core.DefaultMentionStickyTTL)
+
+// mentionMediaTargetFor returns the ONE project configured to receive messages
+// that carry attachments but no text at all (config: media_default = true).
+// Returns "" when no project claims them.
+//
+// It is a separate lookup from mentionRoutingFor because the two answer different
+// questions: mentionRoutingFor says "is the gate on for me, and who are my
+// peers", while this says "when a photo names nobody, whose is it". The result is
+// handed to EVERY engine, not only to the winner — see Engine.SetMentionMediaTarget.
+func mentionMediaTargetFor(cfg *config.Config) string {
+	if cfg == nil {
+		return ""
+	}
+	for i := range cfg.MentionAgents {
+		m := &cfg.MentionAgents[i]
+		if m.MediaDefault != nil && *m.MediaDefault {
+			return m.Project
+		}
+	}
+	return ""
+}
+
+// mentionRoutingFor resolves the mention-gate policy for one project from the
+// global [[mention_agents]] table.
+//
+// It returns the project's own aliases, every OTHER listed project's aliases,
+// the fallback action, and whether the gate is enabled at all.
+//
+// A project is gated only when it has an entry with enabled = true, but the
+// peers list is built from ALL entries regardless of their own enabled flag:
+// a gated agent must still recognize its peers' names in order to stay quiet,
+// so every agent has to be listed even while only some of them are gated.
+func mentionRoutingFor(cfg *config.Config, projectName string) (self []string, peers map[string][]string, fallback string, enabled bool) {
+	if cfg == nil || len(cfg.MentionAgents) == 0 {
+		return nil, nil, "", false
+	}
+
+	var entry *config.MentionAgentConfig
+	for i := range cfg.MentionAgents {
+		if cfg.MentionAgents[i].Project == projectName {
+			entry = &cfg.MentionAgents[i]
+			break
+		}
+	}
+	if entry == nil || entry.Enabled == nil || !*entry.Enabled || len(entry.Aliases) == 0 {
+		return nil, nil, "", false
+	}
+
+	peers = make(map[string][]string, len(cfg.MentionAgents))
+	for _, m := range cfg.MentionAgents {
+		if m.Project == projectName || len(m.Aliases) == 0 {
+			continue
+		}
+		peers[m.Project] = m.Aliases
+	}
+
+	fallback = strings.TrimSpace(entry.Default)
+	if fallback == "" {
+		fallback = "answer"
+	}
+	return entry.Aliases, peers, fallback, true
+}
+
