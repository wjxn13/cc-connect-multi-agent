+// ── Cross-agent mention gate ────────────────────────────────
+
+// mentionUnaddressed is the pseudo project name reported when the gate drops a
+// message that carries no known alias while default = "silent".
+const mentionUnaddressed = "(unaddressed)"
+
+// SetMentionRouting installs the mention-gate policy for this engine.
+//
+// self lists the aliases users may use to address THIS agent; peers maps each
+// other project name to its aliases. Both are matched case-insensitively and
+// an alias may be written with or without the leading "@". Passing an empty
+// self disables the gate, which restores the exact pre-existing behavior —
+// that is what keeps the whole feature opt-in and regression-free.
+//
+// defaultAction decides what happens when the message contains no known alias
+// at all: "answer" (default) lets it through, "silent" drops it.
+func (e *Engine) SetMentionRouting(self []string, peers map[string][]string, defaultAction string) {
+	selfAliases := normalizeMentionAliases(self)
+
+	var peerAliases []string
+	peerOwner := make(map[string]string)
+	for project, aliases := range peers {
+		for _, a := range normalizeMentionAliases(aliases) {
+			if _, dup := peerOwner[a]; dup {
+				continue
+			}
+			peerOwner[a] = project
+			peerAliases = append(peerAliases, a)
+		}
+	}
+	sort.Slice(peerAliases, func(i, j int) bool {
+		return len(peerAliases[i]) > len(peerAliases[j])
+	})
+
+	action := strings.ToLower(strings.TrimSpace(defaultAction))
+	if action != "silent" {
+		action = "answer"
+	}
+
+	e.mentionMu.Lock()
+	defer e.mentionMu.Unlock()
+	e.mentionAliases = selfAliases
+	e.mentionPeerAlias = peerAliases
+	e.mentionPeerOwner = peerOwner
+	e.mentionDefault = action
+}
+
+// SetMentionSticky installs the process-wide registry that remembers which
+// project a session last addressed. Without it the gate still works, but a
+// text-less media message can only be resolved by the plain default — which is
+// what made a photo vanish on a project configured with default = "silent".
+func (e *Engine) SetMentionSticky(s *MentionSticky) {
+	e.mentionMu.Lock()
+	defer e.mentionMu.Unlock()
+	e.mentionSticky = s
+}
+
+// SetMentionMediaTarget names the ONE project configured to receive media that
+// names nobody (config: media_default = true on that project). Pass "" when no
+// project claims it, in which case unaddressed media falls through to the plain
+// default and behaves exactly as before this option existed.
+//
+// Every engine in the process is told the same target name — not merely whether
+// it is the target itself — because a non-target engine must distinguish "a peer
+// owns this photo" (drop it) from "nobody owns it" (fall through to default,
+// which an "answer" project would then take).
+func (e *Engine) SetMentionMediaTarget(project string) {
+	e.mentionMu.Lock()
+	defer e.mentionMu.Unlock()
+	e.mentionMediaTarget = strings.TrimSpace(project)
+}
+
+// MentionGateEnabled reports whether the mention gate is active on this engine.
+func (e *Engine) MentionGateEnabled() bool {
+	e.mentionMu.RLock()
+	defer e.mentionMu.RUnlock()
+	return len(e.mentionAliases) > 0
+}
+
+// mentionGateDrop decides whether the message should be dropped because it
+// addresses another agent. It returns the addressed project name and the
+// matched token; an empty project name means "do not drop".
+//
+// The rule is positional, not set-based: the FIRST alias that appears in the
+// message wins. A set-based rule ("drop whenever a peer alias appears
+// anywhere") breaks on messages that address several agents, e.g.
+// "@claude ask @dsh to run it" — it would silence BOTH agents and the user
+// would see no reply at all, which is the worst possible failure mode.
+func (e *Engine) mentionGateDrop(content string) (string, string) {
+	e.mentionMu.RLock()
+	self := e.mentionAliases
+	peerAliases := e.mentionPeerAlias
+	peerOwner := e.mentionPeerOwner
+	fallback := e.mentionDefault
+	e.mentionMu.RUnlock()
+
+	if len(self) == 0 {
+		return "", "" // gate disabled for this engine
+	}
+
+	for _, token := range scanMentionTokens(content) {
+		selfAlias, selfHit := longestAliasPrefix(token, self)
+		peerAlias, peerHit := longestAliasPrefix(token, peerAliases)
+
+		if selfHit && (!peerHit || len(selfAlias) >= len(peerAlias)) {
+			return "", "" // addressed to us — let it through
+		}
+		if peerHit {
+			owner := peerOwner[peerAlias]
+			if owner == "" {
+				owner = peerAlias
+			}
+			return owner, token
+		}
+	}
+
+	// The message mentions nobody we know.
+	if fallback == "silent" {
+		return mentionUnaddressed, ""
+	}
+	return "", ""
+}
+
+// mentionGateBlocked reports whether a message addresses a DIFFERENT agent and,
+// if so, logs the drop so the caller can return early. Every delivery path is
+// expected to go through this helper.
+//
+// Only handleMessage is reached by live chat traffic. Cron, timer, heartbeat
+// and webhook inject synthetic messages straight into the processing loop and
+// would otherwise bypass the gate entirely — a scheduled prompt such as
+// "@dsh run the report" stored on the Claude project would keep waking Claude
+// every morning even though the gate is on. Those callers must invoke this
+// helper BEFORE resolving platforms or locking sessions, so that a skipped
+// turn costs nothing at all: no notification, no session, no agent process.
+//
+// Slash-command paths (executeCustomCommand / executeSkill) deliberately do
+// NOT call this: they are explicit user commands, and the "/" exemption below
+// keeps them working no matter what their arguments happen to mention.
+//
+// The gate itself is a no-op when this engine has no aliases configured, so a
+// project without a [[mention_agents]] entry behaves exactly as before.
+func (e *Engine) mentionGateBlocked(origin, content, sessionKey, user string) bool {
+	// A command is an instruction to THIS agent by construction, so it is never
+	// read as addressing a peer. Trim first: prompts written as TOML multi-line
+	// strings routinely carry a leading newline or indentation.
+	if strings.HasPrefix(strings.TrimSpace(content), "/") {
+		return false
+	}
+	peer, token := e.mentionGateDrop(content)
+	if peer == "" {
+		// The message stays with us. When it named us explicitly, remember that
+		// for a short while so a follow-up message that names nobody — a bare
+		// Weixin photo above all — still arrives here. Messages that merely fall
+		// through on default="answer" deliberately do NOT create stickiness: an
+		// unaddressed aside in a multi-project chat would otherwise silently
+		// steal the next photo from the project the user actually addressed.
+		if e.mentionsSelf(content) {
+			e.rememberAddressee(sessionKey)
+		}
+		return false
+	}
+	slog.Info("mention gate: message dropped",
+		"project", e.name,
+		"origin", origin,
+		"addressed", peer,
+		"token", token,
+		"session", sessionKey,
+		"user", user,
+	)
+	return true
+}
+
+// rememberAddressee records this project as the session's most recent target.
+func (e *Engine) rememberAddressee(sessionKey string) {
+	e.mentionMu.RLock()
+	sticky := e.mentionSticky
+	e.mentionMu.RUnlock()
+	sticky.Mark(sessionKey, e.name)
+}
+
+// mentionsSelf reports whether content explicitly names this agent, applying the
+// same positional rule as the gate itself: the FIRST known alias in the message
+// decides, and only then does it matter whether that alias is ours.
+//
+// This mirrors mentionGateDrop on purpose. If the two diverged, a message could
+// be simultaneously "kept by the gate" and "not recognised as addressed to us",
+// and the stickiness it created would then be one the gate never honours.
+func (e *Engine) mentionsSelf(content string) bool {
+	e.mentionMu.RLock()
+	self := e.mentionAliases
+	peerAliases := e.mentionPeerAlias
+	e.mentionMu.RUnlock()
+	if len(self) == 0 {
+		return false
+	}
+	for _, token := range scanMentionTokens(content) {
+		selfAlias, selfHit := longestAliasPrefix(token, self)
+		peerAlias, peerHit := longestAliasPrefix(token, peerAliases)
+		if selfHit && (!peerHit || len(selfAlias) >= len(peerAlias)) {
+			return true
+		}
+		if peerHit {
+			return false
+		}
+	}
+	return false
+}
+
+// bareMediaMessage reports whether a message carries attachments but no text.
+//
+// This is the shape a Weixin photo always has. The content check trims first
+// because platforms differ on whether they send "" or a whitespace-only body for
+// a caption-less attachment.
+func bareMediaMessage(msg *Message) bool {
+	if msg == nil || strings.TrimSpace(msg.Content) != "" {
+		return false
+	}
+	return len(msg.Images) > 0 || len(msg.Files) > 0 || msg.Audio != nil
+}
+
+// mediaRouteOwner resolves who should receive a text-less media message.
+//
+// claimed=false means "nobody claims it, use the plain default". When claimed is
+// true, `mine` tells this engine whether it is the owner — the two are separate
+// so that a peer being the owner results in a DROP rather than a fall-through to
+// default="answer".
+func (e *Engine) mediaRouteOwner(sessionKey string) (claimed bool, mine bool, owner string) {
+	e.mentionMu.RLock()
+	sticky := e.mentionSticky
+	target := e.mentionMediaTarget
+	self := e.name
+	e.mentionMu.RUnlock()
+
+	if owner := sticky.Lookup(sessionKey); owner != "" {
+		return true, owner == self, owner
+	}
+	if target != "" {
+		return true, target == self, target
+	}
+	return false, false, ""
+}
+
+// mentionGateBlocksMessage is the gate entry point for LIVE CHAT traffic, and it
+// differs from mentionGateBlocked in exactly one respect: it understands that a
+// message carrying attachments and no text has no aliases to scan.
+//
+// Without this, a Weixin photo sent to a project the user had just addressed was
+// read as "addressing nobody", hit default="silent", and was discarded — the
+// picture simply never arrived, and the user saw a project that "did not react".
+// Measured 2026-09-19: the Weixin client cannot attach a caption (the image
+// preview has no text box), quoting a photo drops the photo, and quoting text
+// while sending a photo drops the quote, so the alias can only ever arrive as a
+// separate message. Cron, timer, heartbeat and webhook traffic keeps calling
+// mentionGateBlocked directly: those prompts are authored text, never bare media.
+func (e *Engine) mentionGateBlocksMessage(msg *Message) bool {
+	if !bareMediaMessage(msg) {
+		return e.mentionGateBlocked("message", msg.Content, msg.SessionKey, msg.UserName)
+	}
+
+	if claimed, mine, owner := e.mediaRouteOwner(msg.SessionKey); claimed {
+		if mine {
+			slog.Info("mention gate: media message kept",
+				"project", e.name,
+				"owner", owner,
+				"session", msg.SessionKey,
+				"user", msg.UserName,
+			)
+			return false
+		}
+		slog.Info("mention gate: media message dropped",
+			"project", e.name,
+			"origin", "message",
+			"addressed", owner,
+			"token", "(media)",
+			"session", msg.SessionKey,
+			"user", msg.UserName,
+		)
+		return true
+	}
+
+	// Nobody was addressed recently and no media owner is configured: keep the
+	// pre-existing rule, so an unconfigured deployment behaves exactly as before.
+	return e.mentionGateBlocked("message", msg.Content, msg.SessionKey, msg.UserName)
+}
