 }
 
+// AgentLabelPrefix reports the rendered outgoing-message prefix ("" when off).
+func (e *Engine) AgentLabelPrefix() string { return e.display.AgentLabel }
+
+// stampAgentLabel prepends the project's agent label to an outgoing message.
+//
+// Motivation: several projects can share a single messaging account, in which
+// case every project consumes every inbound message and the user has no way to
+// tell which one produced a given reply, error, or queue notice. The label
+// makes the origin explicit.
+//
+// It is deliberately applied at the ENGINE's two send choke points rather than
+// in each caller: on platforms without buttons/cards (Weixin is one) Reply and
+// Send are the only two outbound doors, so a single stamp covers everything the
+// user can see.
+//
+// Note: platforms that split long text into multiple chat messages (Weixin
+// does) apply the label to the first chunk only, which is the desired
+// behaviour — the label identifies the sender, it does not need repeating.
+func (e *Engine) stampAgentLabel(content string) string {
+	prefix := e.display.AgentLabel
+	if prefix == "" || content == "" {
+		return content
+	}
+	return prefix + content
+}
