+// normalizeMentionAliases canonicalizes aliases: trimmed, lowercased, exactly
+// one leading "@", deduplicated, and sorted longest-first so that prefix
+// matching prefers the most specific alias ("@claude-code" over "@claude").
+func normalizeMentionAliases(in []string) []string {
+	if len(in) == 0 {
+		return nil
+	}
+	out := make([]string, 0, len(in))
+	seen := make(map[string]bool, len(in))
+	for _, raw := range in {
+		a := strings.ToLower(strings.TrimSpace(raw))
+		a = strings.TrimSpace(strings.TrimPrefix(a, "@"))
+		if a == "" {
+			continue
+		}
+		a = "@" + a
+		if seen[a] {
+			continue
+		}
+		seen[a] = true
+		out = append(out, a)
+	}
+	sort.Slice(out, func(i, j int) bool { return len(out[i]) > len(out[j]) })
+	return out
+}
+
+// longestAliasPrefix returns the longest alias that prefixes token. Aliases
+// are expected lowercase and sorted longest-first, because the first hit is
+// then the most specific one. Comparison is byte-wise on purpose: it is only
+// ever applied between a token and one of its own prefixes, so the result is
+// identical to a rune-wise comparison while avoiding a conversion per call.
+func longestAliasPrefix(token string, aliases []string) (string, bool) {
+	for _, a := range aliases {
+		if strings.HasPrefix(token, a) {
+			return a, true
+		}
+	}
+	return "", false
+}
+
+// scanMentionTokens extracts every "@name" token from content in the order it
+// appears. Names may contain letters, digits, "_", "-", and CJK characters —
+// the CJK part matters because Chinese has no word separators, so "@dsh你好"
+// must yield the token "@dsh你好"; the alias matcher then treats "@dsh" as a
+// prefix of it.
+//
+// A "@" is only treated as a mention when it is NOT preceded by a name
+// character, which keeps email addresses and handles such as
+// "a@dsh.example" from being mistaken for a mention.
+func scanMentionTokens(content string) []string {
+	runes := []rune(content)
+	var out []string
+	for i := 0; i < len(runes); i++ {
+		if runes[i] != '@' {
+			continue
+		}
+		if i > 0 && isMentionNameRune(runes[i-1]) {
+			continue
+		}
+		j := i + 1
+		for j < len(runes) && isMentionNameRune(runes[j]) {
+			j++
+		}
+		if j > i+1 {
+			out = append(out, strings.ToLower(string(runes[i:j])))
+		}
+		i = j - 1
+	}
+	return out
+}
+
+// isMentionNameRune reports whether r can be part of an "@name" token.
+func isMentionNameRune(r rune) bool {
+	switch {
+	case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9':
+		return true
+	case r == '_' || r == '-':
+		return true
+	case r >= 0x4e00 && r <= 0x9fff: // CJK Unified Ideographs
+		return true
+	case r >= 0x3040 && r <= 0x30ff: // Hiragana + Katakana
+		return true
+	case r >= 0xac00 && r <= 0xd7af: // Hangul syllables
+		return true
+	}
+	return false
+}
