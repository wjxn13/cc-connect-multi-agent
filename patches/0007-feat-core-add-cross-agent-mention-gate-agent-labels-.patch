+// MentionAgentConfig declares one agent's @ mention aliases for the
+// cross-agent mention gate.
+//
+// The gate addresses a problem specific to running MULTIPLE projects against
+// the SAME messaging account: every project consumes every incoming message,
+// so when a user writes "@dsh do X" the Claude bridge also starts a turn and
+// bills tokens only to answer NO_REPLY. With this configured and enabled, the
+// non-addressed agent drops the message BEFORE spawning its process.
+//
+// Only projects with enabled = true are gated; the rest keep their current
+// behavior. Every agent should still be listed, because a gated project needs
+// its peers' aliases in order to recognize "this names someone else".
+//
+//	[[mention_agents]]
+//	project = "my-project"          # must match a [[projects]] name
+//	aliases = ["@claude", "@cc"]    # how users address this agent
+//	enabled = true                  # false or omitted = gate off for this project
+//	default = "answer"              # no alias present at all: answer | silent
+type MentionAgentConfig struct {
+	Project string   `toml:"project"`
+	Aliases []string `toml:"aliases"`
+	Enabled *bool    `toml:"enabled,omitempty"`
+	Default string   `toml:"default,omitempty"`
+	// MediaDefault marks THIS project as the handler for messages that carry
+	// attachments but no text at all — a Weixin photo is the case that motivated
+	// it, because the client cannot attach a caption (the image preview screen
+	// has no text box) and quoting either side of the pair loses the other half.
+	// The alias therefore always arrives as a SEPARATE message, leaving the photo
+	// itself unaddressed.
+	//
+	// Set it on exactly one project. When none does, such messages keep the
+	// pre-existing behaviour: default="silent" projects drop them.
+	MediaDefault *bool `toml:"media_default,omitempty"`
+}
+
+// NormalizeMentionAlias canonicalizes a single alias: trims surrounding
+// space, lowercases it, and guarantees exactly one leading "@". Returns ""
+// when the input carries no name characters (e.g. "" or "@").
+func NormalizeMentionAlias(s string) string {
+	s = strings.ToLower(strings.TrimSpace(s))
+	s = strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(s), "@"))
+	if s == "" {
+		return ""
+	}
+	return "@" + s
+}
+
+// normalizeMentionAliasList applies NormalizeMentionAlias to a list, dropping
+// empties and duplicates while preserving the original order.
+func normalizeMentionAliasList(in []string) []string {
+	if len(in) == 0 {
+		return nil
+	}
+	out := make([]string, 0, len(in))
+	seen := make(map[string]bool, len(in))
+	for _, a := range in {
+		n := NormalizeMentionAlias(a)
+		if n == "" || seen[n] {
+			continue
+		}
+		seen[n] = true
+		out = append(out, n)
+	}
+	return out
+}
+
